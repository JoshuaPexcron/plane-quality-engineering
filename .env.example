# Copy to .env and fill in. .env is git-ignored — real values never enter the repo.

# Where the Plane instance under test runs
PLANE_BASE_URL=http://localhost

# Instance admin account (created during Plane's first-run setup)
PLANE_ADMIN_EMAIL=
PLANE_ADMIN_PASSWORD=

# Personal Access Token for the public REST API (profile settings > API tokens)
PLANE_API_TOKEN=

# Test accounts for the member and guest roles (created by the seed script)
PLANE_MEMBER_EMAIL=
PLANE_GUEST_EMAIL=
PLANE_TEST_PASSWORD=
