# Copy to .env and fill in the first three values. `npm run seed` fills in the rest.
# .env is git-ignored: real values never enter the repo.

# Where the Plane instance under test runs
PLANE_BASE_URL=http://localhost

# Instance admin account (created during Plane's first-run setup)
PLANE_ADMIN_EMAIL=
PLANE_ADMIN_PASSWORD=

# Written by scripts/seed.ts
PLANE_WORKSPACE_SLUG=
PLANE_OTHER_WORKSPACE_SLUG=
PLANE_API_TOKEN=
PLANE_MEMBER_API_TOKEN=
PLANE_MEMBER_EMAIL=
PLANE_GUEST_EMAIL=
PLANE_TEST_PASSWORD=
