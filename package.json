{
  "name": "plane-quality-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Risk-based test automation for Plane, an open-source project management platform: Playwright, TypeScript, API testing, and CI with a live quality dashboard.",
  "author": "Joshua Haas",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "seed": "node scripts/seed.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaPexcron/plane-quality-engineering.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
